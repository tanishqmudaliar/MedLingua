DATABASE_URL=postgresql+asyncpg://medlingua:medlingua@localhost:5432/medlingua
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=20
FRONTEND_ORIGIN=http://localhost:3000

# Hardware-Constrained Local AI Inference
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_NUM_CTX=2048
LLM_MAX_OUTPUT_TOKENS=512
LLM_GPU_REQUIRED=true
LLM_API_BASE=http://localhost:11434
SUMMARY_FALLBACK_ENABLED=true

# AI4Bharat IndicTrans2 Settings
INDICTRANS_MODEL_NAME=ai4bharat/indictrans2-en-indic-dist-200M
INDICTRANS_DEVICE=auto
HF_TOKEN=hf_your_hugging_face_token_here
